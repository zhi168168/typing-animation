{
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "functions": {
    "api/account.mjs": { "maxDuration": 60 },
    "api/billing.mjs": { "maxDuration": 60 }
  },
  "rewrites": [
    {
      "source": "/api/billing/:path*",
      "destination": "/api/billing?__billingPath=:path*"
    },
    {
      "source": "/api/auth/:path*",
      "destination": "/api/account?__authPath=:path*"
    },
    { "source": "/editor", "destination": "/editor.html" },
    { "source": "/account", "destination": "/account.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/account",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
