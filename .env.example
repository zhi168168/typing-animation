# Copy to .env and set your actual public origin before deployment.
# Do not use a path, query string, or fragment. Leave blank for local preview.
SITE_URL=https://typing-animation.com

# Independent account service. Never use VITE_ for secrets.
# ACCOUNT_ORIGIN=https://typing-animation.com
# DATABASE_URL=postgresql://user:password@host/typeflow?sslmode=require
# BETTER_AUTH_SECRET=generate-an-independent-random-secret-with-at-least-32-characters
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_FROM=Typing Animation <accounts@typing-animation.com>
# SMTP_USER=
# SMTP_PASS=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Google callback: https://typing-animation.com/api/auth/callback/google
# Local only: AUTH_DEV_MODE=true and ACCOUNT_ORIGIN=http://127.0.0.1:3000

# Waffo Pancake server-only configuration, from API & Development.
# Required secrets: merchant ID and private key only. Never use VITE_.
WAFFO_ENVIRONMENT=test
WAFFO_MERCHANT_ID=
WAFFO_PRIVATE_KEY=
WAFFO_STORE_ID=
WAFFO_SINGLE_PRODUCT_ID=
WAFFO_MONTH_PASS_PRODUCT_ID=
# Legacy subscriptions only; not used for new purchases.
WAFFO_MONTHLY_PRODUCT_ID=
